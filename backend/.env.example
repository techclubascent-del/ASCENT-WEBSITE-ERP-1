# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Found in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — used for client-side operations
SUPABASE_ANON_KEY=your-anon-key

# Service role key — has elevated privileges, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret — used to verify Supabase-issued tokens
# Found in Supabase dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Application ───────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Set to "development" or "production"
ENVIRONMENT=development
